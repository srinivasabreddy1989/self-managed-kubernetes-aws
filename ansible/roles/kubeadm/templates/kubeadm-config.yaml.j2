apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ private_ip_address }}"
  bindPort: 6443
nodeRegistration:
  name: "{{ ec2_tags.Name }}"
  criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: "{{ project_name }}-cluster"
kubernetesVersion: "{{ kubernetes_version }}"
controlPlaneEndpoint: "{{ kubernetes_api_endpoint }}"
networking:
  podSubnet: "{{ pod_subnet }}"
  serviceSubnet: "{{ service_subnet }}"
  dnsDomain: cluster.local
apiServer:
  certSANs:
    - "{{ kubernetes_api_endpoint | regex_replace(':6443$', '') }}"
{% for control_plane_host in groups['control_plane'] | sort %}
    - "{{ hostvars[control_plane_host].private_ip_address }}"
{% endfor %}
etcd:
  local:
    dataDir: /var/lib/etcd
